<!doctype html><html lang=en><head><meta name=generator content="Hugo 0.152.2"><meta charset=UTF-8><meta name=viewport content="width=device-width,initial-scale=1"><title>OnDB | Query and monetize proprietary data for AI agents</title><meta name=description content="One API to discover, query, and pay for proprietary data across any provider. Automatic settlement, zero migration."><link rel=canonical href=https://ondb.ai/><meta name=robots content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"><meta name=theme-color content="#0A2540"><meta name=color-scheme content="light dark"><meta property="og:type" content="website"><meta property="og:site_name" content="OnDB"><meta property="og:title" content="OnDB | Query and monetize proprietary data for AI agents"><meta property="og:description" content="One API to discover, query, and pay for proprietary data across any provider. Automatic settlement, zero migration."><meta property="og:url" content="https://ondb.ai/"><meta property="og:image" content="https://ondb.ai/images/og-card.png"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="OnDB — Query and monetize proprietary data for AI agents"><meta property="og:locale" content="en_US"><meta name=twitter:card content="summary_large_image"><meta name=twitter:site content="@ondbai"><meta name=twitter:creator content="@ondbai"><meta name=twitter:title content="OnDB | Query and monetize proprietary data for AI agents"><meta name=twitter:description content="One API to discover, query, and pay for proprietary data across any provider. Automatic settlement, zero migration."><meta name=twitter:image content="https://ondb.ai/images/og-card.png"><meta name=twitter:image:alt content="OnDB — Query and monetize proprietary data for AI agents"><link rel=icon type=image/svg+xml href=/images/logo.svg><link rel=icon type=image/png sizes=32x32 href=/favicon-32.png><link rel=apple-touch-icon sizes=180x180 href=/apple-touch-icon.png><link rel=manifest href=/site.webmanifest><script type=application/ld+json>{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https:\/\/ondb.ai\/#organization","name":"OnDB","legalName":"OnDB Inc.","url":"https:\/\/ondb.ai\/","logo":"https:\/\/ondb.ai\/images\/logo-full.svg","description":"\"The single API to discover, query, and pay for proprietary data across any provider. Automatic settlement, zero migration.\"","sameAs":["https://x.com/ondbai","https://github.com/ondbai","https://www.linkedin.com/company/ondbai"]},{"@type":"WebSite","@id":"https:\/\/ondb.ai\/#website","url":"https:\/\/ondb.ai\/","name":"OnDB","description":"\"The single API to discover, query, and pay for proprietary data across any provider. Automatic settlement, zero migration.\"","publisher":{"@id":"https:\/\/ondb.ai\/#organization"},"inLanguage":"en-US"},{"@type":"SoftwareApplication","name":"OnDB","applicationCategory":"DeveloperApplication","operatingSystem":"Cross-platform","description":"\"The single API to discover, query, and pay for proprietary data across any provider. Automatic settlement, zero migration.\"","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"url":"https:\/\/ondb.ai\/","publisher":{"@id":"https:\/\/ondb.ai\/#organization"}}]}</script><script type=application/ld+json>{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What kind of data can I publish?","acceptedAnswer":{"@type":"Answer","text":"Any REST or GraphQL API, PostgreSQL, MongoDB, Supabase, ClickHouse, or hosted dataset. If it has a schema, it works — the OnDB connector wraps it into a queryable endpoint."}},{"@type":"Question","name":"How do payments work?","acceptedAnswer":{"@type":"Answer","text":"OnDB implements HTTP 402 natively. Every request is priced per query and settled automatically via x402 or Machine Payments Protocol (MPP) — no billing logic or reconciliation on your end."}},{"@type":"Question","name":"How does revenue sharing work?","acceptedAnswer":{"@type":"Answer","text":"You set your per-query price in code. OnDB meters usage, splits revenue between providers and the platform automatically, and pays out to your wallet. Share ratios are configured server-side."}},{"@type":"Question","name":"How do AI agents discover my data?","acceptedAnswer":{"@type":"Answer","text":"Agents read a standardized skills.md definition exposed by your OnDB endpoint. No marketplace listing — just publish, and any agent that speaks the protocol can find, query, and pay for your data."}},{"@type":"Question","name":"How is this different from other AI tools?","acceptedAnswer":{"@type":"Answer","text":"Most tools help agents generate output. OnDB is the infrastructure between agents and the data they need — a payment-native query layer that routes across providers and settles in real time."}},{"@type":"Question","name":"Does my data leave my infrastructure?","acceptedAnswer":{"@type":"Answer","text":"No. The OnDB connector runs inside your environment and queries are processed locally — only the query response is returned to the agent. Your databases, APIs, and raw data stay exactly where they are."}},{"@type":"Question","name":"How is data secured in transit?","acceptedAnswer":{"@type":"Answer","text":"All traffic is TLS 1.3 end-to-end. Payment proofs are signed via x402, and data never leaves your infrastructure — OnDB routes requests to your connector without proxying payloads through a middleman."}}]}</script><link rel=preconnect href=https://fonts.googleapis.com><link rel=preconnect href=https://fonts.gstatic.com crossorigin><link href="https://fonts.googleapis.com/css2?family=Host+Grotesk:ital,wght@0,400;0,500;0,600;0,700&family=Manrope:wght@400;500;600;700&family=Geist:wght@400;500;700&family=Geist+Mono:wght@400;500&display=swap" rel=stylesheet><link rel=stylesheet href=/css/styles.css><script src=https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js defer></script></head><body><nav class=site-nav><div class=nav-inner><a href=/ class=nav-logo aria-label="OnDB home"><img src=/images/logo-full-white-text.svg alt=OnDB height=32 class="nav-logo-full nav-logo-light">
