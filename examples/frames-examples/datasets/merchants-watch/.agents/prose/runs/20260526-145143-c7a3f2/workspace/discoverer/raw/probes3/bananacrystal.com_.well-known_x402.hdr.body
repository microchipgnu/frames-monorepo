                  href="https://www.bananacrystal.com/llms.txt"
                  style="
                    color: var(--primary);
                    text-decoration: underline;
                    text-underline-offset: 2px;
                  "
                  target="_blank"
                  rel="noopener"
                  >llms.txt</a
                >
              </p>
              <div style="display: flex; gap: 0.75rem; margin-top: 1.25rem">
