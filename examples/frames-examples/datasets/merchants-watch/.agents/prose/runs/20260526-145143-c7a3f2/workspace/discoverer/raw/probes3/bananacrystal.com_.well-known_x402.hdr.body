                  href="https://x.com/_bananacrystal"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="BananaCrystal on X"
                  style="
                    color: var(--fg-muted);
                    transition: color 0.15s;
                    text-decoration: none;
                  "
                  onmouseover="this.style.color = 'var(--primary)'"
                  onmouseout="this.style.color = 'var(--fg-muted)'"
