<html lang="en">
  <head>
<meta name="twitter:site" content="@_bananacrystal" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BananaCrystal — Header</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      :root {
        --bg: #f8f7ff;
        --bg-alt: #f0eef9;
        --surface: #ffffff;
        --surface-up: #f4f2ff;
        --border: #e2dff5;
        --border-strong: #c8c3e8;
        --fg: #0d0b1a;
        --fg-mid: #3d3860;
        --fg-muted: #6b6690;
        --fg-subtle: #9e9bc0;
        --primary: #7c3aed;
        --primary-light: #9b6ef5;
        --primary-dim: rgba(124, 58, 237, 0.1);
        --primary-soft: rgba(124, 58, 237, 0.2);
        --display: "Libre Baskerville", Georgia, serif;
        --sans: "DM Sans", system-ui, sans-serif;
        --mono: "Inter", monospace;
        --nav-h: 64px;
        --radius: 14px;
        --shadow: 0 2px 16px rgba(124, 58, 237, 0.08);
        --shadow-lg: 0 8px 40px rgba(124, 58, 237, 0.14);
      }
      html {
        font-size: clamp(15px, 1.1vw, 18px);
        overflow-x: hidden;
      }
      body {
        font-family: var(--sans);
        background: var(--bg);
        color: var(--fg);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        width: 100%;
        max-width: 100%;
      }
      a {
        text-decoration: none;
        color: inherit;
      }

      /* ── NAV ── */
      .bc-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10000;
        height: var(--nav-h);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 2rem;
        background: rgba(248, 247, 255, 0.92);
        backdrop-filter: blur(24px) saturate(1.4);
        border-bottom: 1px solid var(--border);
        transition: all 0.3s;
        width: 100%;
        max-width: 100vw;
        overflow: visible;
      }
      .bc-nav.scrolled {
        box-shadow: 0 2px 20px rgba(124, 58, 237, 0.08);
      }
      .bc-nav-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-family: var(--display);
        font-size: 1rem;
        font-weight: 700;
        color: var(--fg);
        letter-spacing: -0.01em;
        flex-shrink: 0;
        white-space: nowrap;
      }
      .bc-nav-logo img {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        flex-shrink: 0;
      }
      .bc-nav-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-shrink: 1;
        min-width: 0;
      }
      .bc-nav-link {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--fg-muted) !important;
        text-decoration: none;
        transition: color 0.15s;
        cursor: pointer;
        background: transparent !important;
        background-color: transparent !important;
        border: none !important;
        border-radius: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
        box-shadow: none !important;
        outline: none !important;
        font-family: var(--sans);
        display: inline-flex;
        align-items: center;
        gap: 4px;
        -webkit-appearance: none;
        appearance: none;
        white-space: nowrap;
      }
      .bc-nav-link:hover {
        color: var(--fg) !important;
        background: transparent !important;
        background-color: transparent !important;
      }
      .bc-nav-link:focus {
        background: transparent !important;
        background-color: transparent !important;
        outline: none !important;
        box-shadow: none !important;
      }
      .bc-nav-link.active {
        color: var(--primary) !important;
        background: transparent !important;
        background-color: transparent !important;
      }
      .bc-nav-dropdown {
        position: relative;
        z-index: 10001;
      }
      .bc-nav-dropdown-menu {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        width: 240px;
        background: #ffffff !important;
        border: 1px solid #e2dff5;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
        transform: translateY(-6px);
        transition:
          opacity 0.2s ease,
          transform 0.2s ease;
        z-index: 10002;
      }
      .bc-nav-dropdown::after {
        content: "";
        position: absolute;
        top: 100%;
        left: -10px;
        right: -10px;
        height: 12px;
        z-index: 10001;
      }
      .bc-nav-dropdown:hover .bc-nav-dropdown-menu,
      .bc-nav-dropdown-menu:hover {
        opacity: 1;
        pointer-events: all;
        transform: translateY(0);
      }
      .bc-nav-dropdown:not(:hover) .bc-nav-dropdown-menu {
        transition-delay: 0.15s;
      }
      .bc-nav-dropdown-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0.75rem 1rem;
        font-size: 0.85rem;
        transition: all 0.15s;
        text-decoration: none;
      }
      .bc-nav-dropdown-item:hover {
        background: #f4f2ff;
        color: #7c3aed;
      }
      .bc-dd-title {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #0d0b1a;
      }
      .bc-dd-sub {
        display: block;
        font-size: 0.72rem;
        color: #6b6690;
        margin-top: 1px;
      }
      .bc-nav-right {
        display: flex;
        align-items: center;
        gap: 1.7rem;
        flex-shrink: 0;
      }
      .bc-nav-ctas {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-shrink: 0;
      }
      .bc-nav-cta-ghost {
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--fg-mid);
        border: 1px solid var(--border-strong);
        padding: 7px 18px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
        background: transparent;
        font-family: var(--sans);
        text-decoration: none;
      }
      .bc-nav-cta-ghost:hover {
        border-color: var(--primary);
        color: var(--primary);
      }
      .bc-nav-cta-solid {
        font-size: 0.82rem;
        font-weight: 600;
        color: #fff;
        background: var(--primary);
        padding: 7px 18px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
        font-family: var(--sans);
        text-decoration: none;
      }
      .bc-nav-cta-solid:hover {
        background: var(--primary-light);
        box-shadow: 0 0 18px rgba(124, 58, 237, 0.3);
      }
      #bc-hamburger {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 6px;
        color: var(--fg-muted);
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        -webkit-appearance: none;
        appearance: none;
        box-shadow: none;
        border-radius: 4px;
      }
      .bc-theme-toggle {
        display: none !important;
      }

      /* ── HAMBURGER ── */
      .bc-nav-hamburger {
        width: 40px;
        height: 40px;
        display: none;
        position: relative;
      }
      .bc-nav-hamburger .bc-ham-top,
      .bc-nav-hamburger .bc-ham-mid,
      .bc-nav-hamburger .bc-ham-bot {
        position: absolute;
        left: 50%;
        width: 18px;
        height: 2px;
        border-radius: 999px;
        background: currentColor;
        transform-origin: center;
        transition:
          transform 0.25s ease,
          opacity 0.2s ease,
          top 0.25s ease,
          bottom 0.25s ease;
      }
      .bc-nav-hamburger .bc-ham-top {
        top: 13px;
        transform: translateX(-50%);
      }
      .bc-nav-hamburger .bc-ham-mid {
        top: 19px;
        transform: translateX(-50%);
      }
      .bc-nav-hamburger .bc-ham-bot {
        top: 25px;
        transform: translateX(-50%);
      }
      .bc-nav-hamburger.open .bc-ham-top {
        top: 19px;
        transform: translateX(-50%) rotate(45deg);
      }
      .bc-nav-hamburger.open .bc-ham-mid {
        opacity: 0;
      }
      .bc-nav-hamburger.open .bc-ham-bot {
        top: 19px;
        transform: translateX(-50%) rotate(-45deg);
      }

      /* ── SLIDE DRAWER ── */
      .bc-drawer-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 9998;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }
      .bc-drawer-overlay.open {
        opacity: 1;
        pointer-events: all;
      }
      .bc-drawer {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: 300px;
        max-width: 85vw;
        background: #ffffff;
        z-index: 9999;
        transform: translateX(100%);
        transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        box-shadow: -8px 0 40px rgba(0, 0, 0, 0.2);
      }
      .bc-drawer.open {
        transform: translateX(0);
      }
      .bc-drawer-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #e2dff5;
      }
      .bc-drawer-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
      }
      .bc-drawer-logo img {
        width: 32px;
        height: 32px;
        border-radius: 8px;
      }
      .bc-drawer-logo span {
        font-family: var(--display);
        font-size: 0.95rem;
        font-weight: 700;
        color: #0d0b1a;
      }
      .bc-drawer-close {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        border: 1.5px solid #c8c3e8;
        background: #f4f2ff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #3d3860;
        flex-shrink: 0;
        padding: 0;
      }
      .bc-drawer-close:hover {
        background: #ede9ff;
        border-color: #7c3aed;
        color: #7c3aed;
      }
      .bc-drawer-body {
        flex: 1;
        overflow-y: auto;
        padding: 1rem 0;
      }
      .bc-drawer-section-label {
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: #9e9bc0;
        padding: 0.75rem 1.5rem 0.25rem;
      }
      .bc-drawer-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 500;
        color: #3d3860;
        text-decoration: none;
        transition:
          background 0.15s,
          color 0.15s;
      }
      .bc-drawer-link:hover {
        background: #f4f2ff;
        color: #7c3aed;
      }
      .bc-drawer-divider {
        height: 1px;
        background: #e2dff5;
        margin: 0.5rem 1.5rem;
      }
      .bc-drawer-footer {
        padding: 1.25rem 1.5rem;
        border-top: 1px solid #e2dff5;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .bc-drawer-btn-ghost {
        display: block;
        text-align: center;
        padding: 0.75rem;
        border-radius: 10px;
        border: 1px solid #c8c3e8;
        font-size: 0.9rem;
        font-weight: 500;
        color: #3d3860;
        text-decoration: none;
        transition: all 0.2s;
      }
      .bc-drawer-btn-ghost:hover {
        border-color: #7c3aed;
        color: #7c3aed;
      }
      .bc-drawer-btn-solid {
        display: block;
        text-align: center;
        padding: 0.75rem;
        border-radius: 10px;
        background: #7c3aed;
        font-size: 0.9rem;
        font-weight: 600;
        color: #fff;
        text-decoration: none;
        transition: all 0.2s;
      }
      .bc-drawer-btn-solid:hover {
        background: #9b6ef5;
      }

      /* ── RESPONSIVE ── */
      @media (max-width: 768px) {
        .bc-nav {
          padding: 0 0.75rem;
          gap: 0;
          justify-content: space-between;
        }
        .bc-nav-links,
        .bc-nav-ctas {
          display: none !important;
        }
        .bc-nav-right {
          gap: 0.75rem;
          margin-left: auto;
        }
        #bc-hamburger {
          display: flex !important;
          padding: 4px !important;
        }
      }
      @media (max-width: 480px) {
        .bc-nav {
          padding: 0 0.5rem;
          gap: 0.25rem;
        }
        .bc-nav-logo {
          font-size: 0.85rem;
          gap: 6px;
        }
        .bc-nav-logo img {
          width: 24px;
          height: 24px;
        }
      }
      @media (max-width: 360px) {
        .bc-nav {
          padding: 0 0.5rem;
        }
        .bc-nav-logo span {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <nav class="bc-nav" id="bc-main-nav">
      <a href="https://www.bananacrystal.com/" class="bc-nav-logo">
        <img
          src="https://media.bananacrystal.com/wp-content/uploads/2024/07/24181620/Logo-128x128-2.png"
          alt="BananaCrystal"
        />
        <span>BananaCrystal</span>
      </a>
      <div class="bc-nav-links">
        <!-- Platform dropdown -->
        <div class="bc-nav-dropdown">
          <button
            class="bc-nav-link"
            style="display: flex; align-items: center; gap: 4px"
          >
            Platform <span style="font-size: 0.65rem; opacity: 0.6">▾</span>
          </button>
          <div class="bc-nav-dropdown-menu">
            <a
              href="https://agents.bananacrystal.com/assets"
              class="bc-nav-dropdown-item"
            >
              <div>
                <strong class="bc-dd-title">Dashboard</strong
                ><span class="bc-dd-sub">Your wallet overview</span>
              </div>
            </a>
            <a
              href="https://agents.bananacrystal.com/trade/fund"
              class="bc-nav-dropdown-item"
            >
              <div>
                <strong class="bc-dd-title">Fund</strong
                ><span class="bc-dd-sub">Deposit USDC</span>
              </div>
            </a>
            <a
              href="https://agents.bananacrystal.com/trade/usdc"
              class="bc-nav-dropdown-item"
            >
              <div>
                <strong class="bc-dd-title">Trade</strong
                ><span class="bc-dd-sub">USDC trading</span>
              </div>
            </a>
            <a
              href="https://agents.bananacrystal.com/trade/swap"
              class="bc-nav-dropdown-item"
            >
              <div>
                <strong class="bc-dd-title">Swap</strong
                ><span class="bc-dd-sub">Currency swaps</span>
              </div>
            </a>
            <a
              href="https://agents.bananacrystal.com/prediction/marketplace"
              class="bc-nav-dropdown-item"
            >
              <div>
                <strong class="bc-dd-title">Prediction</strong
                ><span class="bc-dd-sub">FX prediction market</span>
              </div>
            </a>
          </div>
        </div>
        <div class="bc-nav-dropdown">
          <button
            class="bc-nav-link"
            style="display: flex; align-items: center; gap: 4px"
          >
            Developers <span style="font-size: 0.65rem; opacity: 0.6">▾</span>
          </button>
          <div class="bc-nav-dropdown-menu">
            <a
              href="https://agents.bananacrystal.com/docs"
              class="bc-nav-dropdown-item"
            >
              <div>
                <strong class="bc-dd-title">Documentation</strong
                ><span class="bc-dd-sub">MCP tools, API reference</span>
              </div>
            </a>
          </div>
        </div>
        <a href="/resources/" class="bc-nav-link">Resources</a>
        <a
          href="https://www.bananacrystal.com/usd-debit-card/"
          class="bc-nav-link"
          >USD Debit Card</a
        >
      </div>
      <div class="bc-nav-right">
        <button
          class="bc-theme-toggle"
          id="bc-theme-toggle"
          aria-label="Toggle dark mode"
          title="Toggle dark/light mode"
        >
          🌙
        </button>
        <button
          class="bc-nav-hamburger"
          id="bc-hamburger"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <span class="bc-ham-top"></span>
          <span class="bc-ham-mid"></span>
          <span class="bc-ham-bot"></span>
        </button>
        <div class="bc-nav-ctas">
          <a
            href="https://agents.bananacrystal.com/auth/login"
            class="bc-nav-cta-ghost"
            >Sign in</a
          >
          <a
            href="https://agents.bananacrystal.com/auth/signup"
            class="bc-nav-cta-solid"
            >Get started free</a
          >
        </div>
      </div>
    </nav>

    <!-- Drawer overlay -->
    <div class="bc-drawer-overlay" id="bc-drawer-overlay"></div>

    <!-- Slide-in drawer -->
    <div class="bc-drawer" id="bc-drawer">
      <div class="bc-drawer-header">
        <a href="https://www.bananacrystal.com/" class="bc-drawer-logo">
          <img
            src="https://media.bananacrystal.com/wp-content/uploads/2024/07/24181620/Logo-128x128-2.png"
            alt="BananaCrystal"
          />
          <span>BananaCrystal</span>
        </a>
        <button
          class="bc-drawer-close"
          id="bc-drawer-close"
          aria-label="Close menu"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          >
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
      <div class="bc-drawer-body">
        <span class="bc-drawer-section-label">Platform</span>
        <a href="https://agents.bananacrystal.com/assets" class="bc-drawer-link"
          >Dashboard</a
        >
        <a
          href="https://agents.bananacrystal.com/trade/fund"
          class="bc-drawer-link"
          >Fund</a
        >
        <a
          href="https://agents.bananacrystal.com/trade/swap"
          class="bc-drawer-link"
          >Swap</a
        >
        <a
          href="https://agents.bananacrystal.com/trade/usdc"
          class="bc-drawer-link"
          >Trade</a
        >
        <a
          href="https://agents.bananacrystal.com/prediction/marketplace"
          class="bc-drawer-link"
          >Prediction</a
        >
        <div class="bc-drawer-divider"></div>
        <span class="bc-drawer-section-label">Developers</span>
        <a href="https://agents.bananacrystal.com/docs" class="bc-drawer-link"
          >Documentation</a
        >
        <div class="bc-drawer-divider"></div>
        <span class="bc-drawer-section-label">More</span>
        <a href="/resources/" class="bc-drawer-link">Resources</a>
        <a
          href="https://www.bananacrystal.com/usd-debit-card/"
          class="bc-drawer-link"
          >USD Debit Card</a
        >
      </div>
      <div class="bc-drawer-footer">
        <a
          href="https://agents.bananacrystal.com/auth/login"
          class="bc-drawer-btn-ghost"
          >Sign in</a
        >
        <a
          href="https://agents.bananacrystal.com/auth/signup"
          class="bc-drawer-btn-solid"
          >Get started free</a
        >
      </div>
    </div>

    <script>
      // Hide/show hamburger vs desktop links based on viewport
      (function () {
        var h = document.getElementById("bc-hamburger");
        var nl = document.querySelector(".bc-nav-links");
        var nc = document.querySelector(".bc-nav-ctas");
        function setNav() {
          var m = window.innerWidth < 769;
          h.style.display = m ? "flex" : "none";
          if (nl) nl.style.display = m ? "none" : "";
          if (nc) nc.style.display = m ? "none" : "";
        }
        setNav();
        window.addEventListener("resize", setNav);
      })();

      // Nav scroll shadow
      window.addEventListener(
        "scroll",
        function () {
          document
            .getElementById("bc-main-nav")
            .classList.toggle("scrolled", window.scrollY > 60);
        },
        { passive: true },
      );

      // Drawer open/close
      var bcDrawer = document.getElementById("bc-drawer");
      var bcOverlay = document.getElementById("bc-drawer-overlay");
      var bcHamburger = document.getElementById("bc-hamburger");

      function openDrawer() {
        bcDrawer.classList.add("open");
        bcOverlay.classList.add("open");
        bcHamburger.classList.add("open");
        bcHamburger.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      }
      function closeDrawer() {
        bcDrawer.classList.remove("open");
        bcOverlay.classList.remove("open");
        bcHamburger.classList.remove("open");
        bcHamburger.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      }

      bcHamburger.setAttribute("aria-expanded", "false");
      bcHamburger.addEventListener("click", function () {
        bcDrawer.classList.contains("open") ? closeDrawer() : openDrawer();
      });
      document
        .getElementById("bc-drawer-close")
        .addEventListener("click", closeDrawer);
      bcOverlay.addEventListener("click", closeDrawer);
    </script>
  </body>
</html>
