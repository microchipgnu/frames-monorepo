    "/api/agentworld/baseball/schedule": {
      "get": {
        "summary": "MLB Schedule Today \u2014 FREE",
        "description": "Free discovery endpoint. Returns today's matchups (teams, time, venue) with no scores. Each game includes links to paid score endpoints so agents know exactly what's available and at what price.",
        "operationId": "getBaseballSchedule",
        "tags": [
          "Baseball"
        ],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "2026-05-20"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Today's game schedule with paid endpoint discovery links",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "schedule": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "game_pk": {
                            "type": "integer"
                          },
                          "home_team": {
                            "type": "string"
                          },
                          "away_team": {
                            "type": "string"
                          },
                          "start_time": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "venue": {
                            "type": "string"
                          },
                          "paid_endpoints": {
                            "type": "object",
                            "description": "x402 endpoints for this game's scores"
                          }
                        }
                      }
                    },
                    "date": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "free": {
                      "type": "boolean"
                    },
                    "odds_url": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "x-payment-info": {
          "required": false,
          "price_usdc": 0,
          "note": "Free \u2014 discovery hook for paid score endpoints"
        }
      }
    }
