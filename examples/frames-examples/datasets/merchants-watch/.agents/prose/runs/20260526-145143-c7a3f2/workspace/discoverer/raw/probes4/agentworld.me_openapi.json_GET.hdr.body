    "/api/agentworld/baseball/odds": {
      "get": {
        "summary": "MLB Betting Odds \u2014 FREE",
        "description": "NPC-derived implied probability odds for all MLB games. Returns American and decimal odds based on AgentWorld NPC betting patterns. Free, rate-limited at 30 req/min per IP.",
        "operationId": "getBaseballOdds",
        "tags": [
          "Baseball"
        ],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "2026-05-20"
            }
          },
          {
            "name": "game_pk",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Odds for all open games",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "odds": {
                      "type": "array"
                    },
                    "date": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "free": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded \u2014 30 req/min per IP"
          }
        },
        "x-payment-info": {
          "required": false,
          "price_usdc": 0,
          "note": "Free"
        }
      }
    },
    "/api/agentworld/baseball/scores/live/paid": {
      "get": {
        "summary": "Live MLB Scoreboard \u2014 $0.001 USDC",
