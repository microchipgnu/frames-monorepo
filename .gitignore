node_modules/
dist/
.DS_Store
.env
.env.local

# Bun
.bun/

# Editor
.vscode/
.idea/

# OS
*.log

# Frames-specific regenerable artifacts (per-dataset)
**/.frame/dataset.db
**/.frame/dataset.db-*
**/.frame/rows.ndjson

# wrangler local state (miniflare KV/cache)
.wrangler/

# OpenProse (per-dataset attached root at .agents/prose/):
#  - workspace/ holds heavy active scratch (HTML body caches, per-service
#    intermediates). Ignored.
#  - .agents/prose/runs/ is the per-run trace (~24-72KB each). Tracked —
#    git history is the audit ledger.
#  - .agents/prose/deps/ holds installed deps. Ignored (regenerable from
#    prose.lock).
**/datasets/*/workspace/
**/datasets/*/.agents/prose/deps/
