{
  "name": "@frames-ag/payment-tempo",
  "version": "0.0.1",
  "description": "MPP Tempo charge client for Faremeter — wraps mppx into a faremeter MPPPaymentHandler so @faremeter/fetch.wrap auto-handles tempo.charge 402s",
  "keywords": [
    "faremeter",
    "mpp",
    "tempo",
    "stripe-l2",
    "x402",
    "agent-payments"
  ],
  "license": "MIT",
  "author": "frames-ag",
  "homepage": "https://github.com/microchipgnu/payment-tempo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microchipgnu/payment-tempo.git"
  },
  "bugs": {
    "url": "https://github.com/microchipgnu/payment-tempo/issues"
  },
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./charge": "./src/charge/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "UPSTREAM_PR.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "bun run examples/smoke.ts",
    "prepublishOnly": "bun typecheck"
  },
  "dependencies": {
    "@faremeter/fetch": "^0.21.0",
    "@faremeter/types": "^0.21.0",
    "mppx": "^0.6.14",
    "viem": "^2.48.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
