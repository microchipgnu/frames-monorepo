{
  "name": "frames-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for the frames-ag stack: frame (dataset/loop layer), pay (buyer-side runtime), catalog (publisher), and frames-examples (downstream demos).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/catalog/server",
    "examples/*"
  ],
  "scripts": {
    "changeset": "bunx changeset",
    "version": "bunx changeset version",
    "release": "bunx changeset publish",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "engines": {
    "bun": ">=1.1.30"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "typescript": "^6.0.3"
  }
}
