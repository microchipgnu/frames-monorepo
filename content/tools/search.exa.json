{
  "pay_protocol": "0.0.1",
  "id": "search.exa",
  "title": "Exa neural web search",
  "description": "Search the public web with Exa's neural index. Returns ranked URLs with snippets and metadata. Best for research-grade discovery where keyword search misses semantic matches.",
  "capabilities": ["web-search"],
  "invocation": {
    "method": "POST",
    "url": "https://api.exa.ai/search",
    "params_schema": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": { "type": "string", "description": "Natural-language search query" },
        "num_results": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 },
        "include_text": { "type": "boolean", "default": false }
      }
    }
  },
  "payment": {
    "protocol": "x402",
    "network": "base",
    "currency": "USDC",
    "price_hint": "0.0125"
  }
}
